lib:"TestLib.dll";
lib:"TestLibAarch64.so";
lib:"TestLib_x86.so";

cls: Test {
    var:var1:int;
    var:var2:int;
    var:var3:SubTest;
    fun:fun1():void -> {
        __hx_write_string__ "[HXVM] 来自类Test\n";
    }
}

cls: SubTest {
    var:subTestVar:float;
}

lib:fun:libFunTest():int;
lib:fun:printI32Value(num:int):void;

函数：主函数（无参数）->{
    __hx_write_string__ "---------------------------------------------\n";
    __hx_write_string__ " HxHLanguage VM v0.114 - 本地库 \n";
    __hx_write_string__ "---------------------------------------------\n";
    
    libFunTest();

    printI32Value(114);
    var:i32Var:int = 514;
    printI32Value(i32Var);
    
    ret：0。
}
